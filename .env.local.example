# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/practice-grow?retryWrites=true&w=majority

# ClickUp API
CLICKUP_API_TOKEN=pk_your_clickup_api_token
CLICKUP_LIST_ID=your_certifications_list_id

# Session encryption key (generate with: openssl rand -hex 32)
SESSION_SECRET=your-32-char-secret-key-here-replace-me

# Cron sync protection
CRON_SECRET=your-cron-secret-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
